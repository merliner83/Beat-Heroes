rules_version = '2';

// Beat-Heroes – Firestore-Regeln. Datenmodell: docs/architecture.md
// Grundsatz: Werte (Rolle, Schule, Credits, Fortschritt) schreibt nur der
// Server (Admin SDK umgeht diese Regeln) oder eine berechtigte Person.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Hilfsfunktionen ---
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return hasProfile() ? me().get('role', 'student') : 'student';
    }

    // Schulen eines Dokuments: schoolIds[] (neu, mehrere Schulen möglich),
    // Rückfall auf das alte Einzelfeld schoolId.
    function schoolsOf(d) {
      return d.get('schoolIds', d.get('schoolId', null) == null ? [] : [d.get('schoolId', null)]);
    }

    function mySchools() {
      return hasProfile() ? schoolsOf(me()) : [];
    }

    function isSuperAdmin() {
      return signedIn() && myRole() == 'superAdmin';
    }

    function isStaff() {
      return signedIn() && myRole() in ['teacher', 'schoolAdmin', 'superAdmin'];
    }

    function isStaffOfSchool(schoolId) {
      return isSuperAdmin() || (isStaff() && schoolId != null && schoolId in mySchools());
    }

    // Gemeinsame Schule mit einer Liste (z.B. schoolIds einer Person).
    // Abfragen müssen nach schoolIds array-contains <eigene Schule> filtern.
    function sharesSchool(ids) {
      return ids.hasAny(mySchools());
    }

    function isStaffOfAny(ids) {
      return isSuperAdmin() || (isStaff() && sharesSchool(ids));
    }

    // Felder, die Nutzer:innen im eigenen Dokument selbst setzen dürfen.
    function selfEditableKeys() {
      return ['uid', 'email', 'displayName', 'photoURL', 'updatedAt'];
    }

    // --- Organisation ---
    // Schulprofile sind öffentlich (Seite /schools/{id}). Schul-Admins
    // pflegen das Profil ihrer Schule, anlegen/löschen nur Super-Admins.
    match /schools/{schoolId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (signedIn() && myRole() == 'schoolAdmin' && schoolId in mySchools()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'logoUrl', 'bannerUrl', 'description', 'website', 'location', 'accentColor', 'updatedAt']));
    }

    match /classes/{classId} {
      allow read: if isStaffOfSchool(resource.data.schoolId)
                  || (signedIn() && resource.data.schoolId in mySchools());
      allow create: if isStaffOfSchool(request.resource.data.schoolId);
      allow update, delete: if isStaffOfSchool(resource.data.schoolId);
    }

    // --- Nutzer:innen (privat) ---
    match /users/{userId} {
      allow get: if signedIn() && (
        request.auth.uid == userId
        || isSuperAdmin()
        || isStaffOfAny(schoolsOf(resource.data))
      );
      // Lehrpersonen listen Schüler:innen ihrer Schulen (Abfrage muss nach
      // schoolIds array-contains filtern).
      allow list: if isStaffOfAny(resource.data.schoolIds);

      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(selfEditableKeys())
        && request.resource.data.uid == userId;

      allow update: if signedIn() && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(selfEditableKeys()))
        || isSuperAdmin()
      );
      allow delete: if isSuperAdmin();

      // Fortschritt: nur lesen, schreiben tut der Server (/api/credits).
      match /{progressCol}/{docId} {
        allow read: if progressCol in ['progress', 'patternProgress', 'articleProgress']
          && signedIn() && (request.auth.uid == userId || isSuperAdmin()
            || isStaffOfAny(schoolsOf(get(/databases/$(database)/documents/users/$(userId)).data)));
        allow write: if false;
      }
    }

    // --- Zuweisungen ---
    // audience 'class': ganze Klasse (classId); 'students': nur studentIds.
    function myClassIds() {
      return hasProfile() ? me().get('classIds', []) : [];
    }

    match /assignments/{assignmentId} {
      allow read: if isStaffOfSchool(resource.data.schoolId)
        || (signedIn() && resource.data.audience == 'class' && resource.data.classId in myClassIds())
        || (signedIn() && request.auth.uid in resource.data.studentIds);
      allow create: if isStaffOfSchool(request.resource.data.schoolId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isStaffOfSchool(resource.data.schoolId)
        && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if isStaffOfSchool(resource.data.schoolId);

      function assignment() {
        return get(/databases/$(database)/documents/assignments/$(assignmentId)).data;
      }

      function canSeeAssignment() {
        return (assignment().audience == 'class' && assignment().classId in myClassIds())
          || request.auth.uid in assignment().studentIds;
      }

      // Abgabe pro Person (Dokument-ID = uid). Schüler:innen dürfen nur
      // einreichen; freigeben und Credits vergeben tut /api/assignments/review.
      match /submissions/{userId} {
        allow read: if signedIn() && (request.auth.uid == userId
          || isStaffOfSchool(assignment().schoolId));
        allow create: if signedIn() && request.auth.uid == userId && canSeeAssignment()
          && request.resource.data.keys().hasOnly(['uid', 'status', 'text', 'link', 'submittedAt', 'displayName'])
          && request.resource.data.uid == userId
          && request.resource.data.status == 'submitted';
        allow update: if signedIn() && request.auth.uid == userId && canSeeAssignment()
          && resource.data.status in ['submitted', 'changes_requested']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'text', 'link', 'submittedAt', 'displayName'])
          && request.resource.data.status == 'submitted';
        allow delete: if false;
      }
    }

    // --- Credits ---
    match /standings/{userId} {
      // Rangliste: lesbar innerhalb derselben Schule (Abfragen müssen nach
      // schoolIds array-contains filtern), eigener Eintrag immer.
      allow read: if signedIn() && (
        request.auth.uid == userId
        || isSuperAdmin()
        || sharesSchool(resource.data.schoolIds)
      );
      allow write: if false;
    }

    match /creditEvents/{eventId} {
      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid
        || isStaffOfAny(resource.data.schoolIds)
      );
      allow write: if false;
    }

    // --- Profile: Entwurf (Schüler:in) → Freigabe (Server) → öffentlich ---
    function profileFields() {
      return ['uid', 'schoolId', 'schoolIds', 'status', 'artistName', 'handle', 'bio', 'avatarUrl',
        'bannerUrl', 'accentColor', 'featuredUrl',
        'roles', 'genres', 'embeds', 'links', 'openForCollab', 'updatedAt', 'submittedAt'];
    }

    function validProfileDraft(d) {
      return d.uid == request.auth.uid
        && d.get('schoolIds', []) == mySchools()
        && d.status in ['draft', 'submitted']
        && d.artistName is string && d.artistName.size() <= 60
        && d.handle is string && d.handle.matches('^[a-z0-9][a-z0-9-]{1,28}[a-z0-9]$')
        && d.get('bio', '').size() <= 1500
        && d.roles.size() <= 12 && d.genres.size() <= 13
        && d.embeds.size() <= 8 && d.links.size() <= 8
        && (d.get('accentColor', null) == null
            || (d.accentColor is string && d.accentColor.matches('^#[0-9a-fA-F]{6}$')))
        && (d.get('featuredUrl', null) == null || d.featuredUrl in d.embeds);
    }

    match /profileDrafts/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId
        || isStaffOfAny(resource.data.schoolIds));
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(profileFields())
        && validProfileDraft(request.resource.data);
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields())
        && validProfileDraft(request.resource.data);
      allow delete: if false;
    }

    // Öffentliche Profile und Handles schreibt nur /api/profiles/review.
    match /profiles/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /handles/{handle} {
      allow read: if true;
      allow write: if false;
    }

    // --- Lernpfad-Abschlüsse (nur Server schreibt, /api/paths/claim) ---
    match /achievements/{achievementId} {
      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid
        || isStaffOfAny(resource.data.schoolIds)
      );
      allow write: if false;
    }

    // --- Lerninhalte (CMS) ---
    match /{contentCol}/{docId} {
      allow read: if contentCol in [
        'studios', 'tracks', 'games', 'learnApps', 'levels', 'patterns',
        'learnCategories', 'learnSubCats', 'articles', 'courses', 'learningPaths'
      ];
      allow write: if isSuperAdmin() && contentCol in [
        'studios', 'tracks', 'games', 'learnApps', 'levels', 'patterns',
        'learnCategories', 'learnSubCats', 'articles', 'learnQuizzes',
        'courses', 'learningPaths'
      ];
    }

    match /levels/{levelId}/sounds/{soundId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Quiz-Fragen sind lesbar, die Lösungen liegen getrennt in learnQuizKeys
    // und werden nur serverseitig (/api/credits) zum Werten gelesen.
    match /learnQuizzes/{quizId} {
      allow read: if true;
    }

    match /learnQuizKeys/{quizId} {
      allow read, write: if isSuperAdmin();
    }
  }
}
