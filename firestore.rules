
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION MATCHES ---

    // User Profile: Owner has full access. Signed-in users can list profiles (needed for rank calculation).
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow write: if isOwner(userId);
      
      match /progress/{levelId} {
        allow read, write: if isOwner(userId);
      }
      match /patternProgress/{patternId} {
        allow read, write: if isOwner(userId);
      }
      match /articleProgress/{articleId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Studios: Public read
    match /studios/{studioId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Tracks: Public read
    match /tracks/{trackId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Games: Public read
    match /games/{gameId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Learn Apps: Public read
    match /learnApps/{appId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Levels & Sounds: Public read
    match /levels/{levelId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /sounds/{soundId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // Patterns: Public read
    match /patterns/{patternId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Learn Categories: Public read
    match /learnCategories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Learn SubCategories: Public read
    match /learnSubCats/{subCategoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Articles (Knowledge Base): Public read
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Quizzes: Public read
    match /learnQuizzes/{quizId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
