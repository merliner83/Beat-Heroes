
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION MATCHES ---

    // User Profile
    match /users/{userId} {
      // Erlaubt das Lesen (get & list) des eigenen Profils ODER öffentlicher Profile.
      // Firestore prüft bei Abfragen (list), ob der Filter (isPublic == true) die Regel erfüllt.
      allow read: if isOwner(userId) || (resource != null && resource.data.isPublic == true);
      
      // Nur der Besitzer darf sein eigenes Profil schreiben.
      allow write: if isOwner(userId);
      
      match /progress/{levelId} {
        allow read, write: if isOwner(userId);
      }
      match /patternProgress/{patternId} {
        allow read, write: if isOwner(userId);
      }
      match /articleProgress/{articleId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Studios
    match /studios/{studioId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Tracks
    match /tracks/{trackId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Games
    match /games/{gameId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Learn Apps
    match /learnApps/{appId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Levels & Sounds
    match /levels/{levelId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /sounds/{soundId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // Patterns
    match /patterns/{patternId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Learn Categories
    match /learnCategories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Learn SubCategories
    match /learnSubCats/{subCategoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Articles (Knowledge Base)
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Quizzes
    match /learnQuizzes/{quizId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
