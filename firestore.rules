rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION MATCHES ---

    // User Profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Studios: Öffentlich lesbar, Erstellung/Bearbeitung für angemeldete Nutzer
    match /studios/{studioId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.ownerUserId == request.auth.uid);
    }

    // Projekte: Öffentlich lesbar, Erstellung für angemeldete Nutzer
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Levels & Sounds: Öffentlich lesbar, Erstellung für angemeldete Nutzer
    match /levels/{levelId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /sounds/{soundId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }
  }
}