
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION MATCHES ---

    // User Profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /progress/{levelId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Studios
    match /studios/{studioId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Games
    match /games/{gameId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Levels & Sounds
    match /levels/{levelId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /sounds/{soundId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // Patterns
    match /patterns/{patternId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
