
{
  "entities": {
    "Studio": {
      "title": "Studio",
      "type": "object",
      "description": "Ein Musik-Studio, das mehrere Spiele enthält.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "coverColor": { "type": "string" },
        "imageUrl": { "type": "string", "description": "Pfad zum Studio-Bild (z.B. /studios/house1.png)" },
        "district": { "type": "string", "description": "Der Stadtteil/Distrikt, in dem das Studio liegt." },
        "tags": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "Stile oder Kategorien (z.B. Hip-Hop, Techno)." 
        },
        "linkUrl": { "type": "string", "format": "uri", "description": "Eine externe Webseite oder Social Media Link." },
        "linkLabel": { "type": "string", "description": "Der Text, der für den Link angezeigt werden soll." },
        "minRole": { "type": "string", "enum": ["admin", "producer", "pro", "free"], "default": "free", "description": "Mindestens erforderliche Rolle für dieses Studio." }
      },
      "required": ["id", "name"]
    },
    "Track": {
      "title": "Track",
      "type": "object",
      "description": "Ein Audio-Track, der als Backing-Track für Spiele oder Vorschau dient.",
      "properties": {
        "id": { "type": "string" },
        "studioId": { "type": "string", "description": "Zugehörigkeit zu einem Studio." },
        "name": { "type": "string" },
        "author": { "type": "string", "description": "Der Produzent des Tracks." },
        "duration": { "type": "number", "description": "Länge in Sekunden." },
        "url": { "type": "string", "format": "uri" }
      },
      "required": ["id", "name", "url"]
    },
    "Game": {
      "title": "Game",
      "type": "object",
      "description": "Ein Minigame innerhalb eines Studios.",
      "properties": {
        "id": { "type": "string" },
        "studioId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["rhythm-producer", "sample-hunter", "disk-dash", "ear-training", "notation-pro"], "description": "Der technische Typ des Spiels." },
        "bpm": { "type": "number", "description": "Spezifisch für Rhythm Producer." },
        "difficulty": { "type": "number", "description": "Schwierigkeitsgrad (1-4)" },
        "trackId": { "type": "string", "description": "ID des zugehörigen Tracks aus der tracks Collection." },
        "backingTrackUrl": { "type": "string", "format": "uri", "description": "Fallback URL für den Backing Track." },
        "backgroundImageUrl": { "type": "string", "format": "uri", "description": "Hintergrundbild für das Spiel-Interface." },
        "minRole": { "type": "string", "enum": ["admin", "producer", "pro", "free"], "default": "free", "description": "Mindestens erforderliche Rolle für dieses Spiel." }
      },
      "required": ["id", "studioId", "name", "type"]
    },
    "Level": {
      "title": "Level",
      "type": "object",
      "description": "Ein Schwierigkeitsgrad innerhalb eines Spiels.",
      "properties": {
        "id": { "type": "string" },
        "gameId": { "type": "string" },
        "difficulty": { "type": "number", "description": "1 bis 4" },
        "name": { "type": "string" }
      },
      "required": ["id", "gameId", "difficulty"]
    },
    "TriggerPattern": {
      "title": "TriggerPattern",
      "type": "object",
      "description": "Ein rhythmisches Muster über 8 Takte (128 Steps).",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "steps": { 
          "type": "array", 
          "items": { "type": "number" },
          "description": "Schritte (0-127) for einen 8-Takt-Loop."
        }
      },
      "required": ["id", "name", "steps"]
    },
    "Sound": {
      "title": "Sound",
      "type": "object",
      "description": "Ein Instrument-Trigger innerhalb eines Levels (Rhythm Producer).",
      "properties": {
        "id": { "type": "string" },
        "levelId": { "type": "string" },
        "type": { "type": "string", "enum": ["kick", "clap", "percs", "misc"] },
        "sampleUrl": { "type": "string", "format": "uri" },
        "patternIds": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "Abfolge von 8-Takt-Patterns." 
        }
      },
      "required": ["id", "levelId", "type", "sampleUrl", "patternIds"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Nutzer-Statistiken, Rollen und Street Credibilities.",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "producer", "pro", "free"], "default": "free" },
        "streetCred": { "type": "number", "default": 0 }
      },
      "required": ["uid"]
    },
    "LevelProgress": {
      "title": "LevelProgress",
      "type": "object",
      "description": "Trackt den Fortschritt eines Nutzers in einem Level.",
      "properties": {
        "levelId": { "type": "string" },
        "accuracy": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["levelId", "accuracy"]
    },
    "Article": {
      "title": "Article",
      "type": "object",
      "description": "Ein KnowHow-Artikel für die Knowledge Base.",
      "properties": {
        "id": { "type": "string" },
        "categoryId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string", "description": "Der Fließtext des Artikels." },
        "videoUrl": { "type": "string", "format": "uri", "description": "Hochformat-Video URL." },
        "imageUrls": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "Bis zu 3 Bilder für die Galerie."
        },
        "minRole": { "type": "string", "enum": ["admin", "producer", "pro", "free"], "default": "free", "description": "Mindestens erforderliche Rolle für dieses Artikel." }
      },
      "required": ["id", "title"]
    }
  },
  "auth": {
    "providers": ["anonymous", "google.com"]
  },
  "firestore": {
    "/studios/{studioId}": {
      "schema": "#/backend/entities/Studio",
      "description": "Öffentliche Studios."
    },
    "/tracks/{trackId}": {
      "schema": "#/backend/entities/Track",
      "description": "Globale Audio-Tracks."
    },
    "/games/{gameId}": {
      "schema": "#/backend/entities/Game",
      "description": "Alle Minigames."
    },
    "/levels/{levelId}": {
      "schema": "#/backend/entities/Level",
      "description": "Levels der Spiele."
    },
    "/levels/{levelId}/sounds/{soundId}": {
      "schema": "#/backend/entities/Sound",
      "description": "Sounds eines Levels."
    },
    "/patterns/{patternId}": {
      "schema": "#/backend/entities/TriggerPattern",
      "description": "Globale Rhythmus-Vorlagen."
    },
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "Nutzer-Profile."
    },
    "/users/{userId}/progress/{levelId}": {
      "schema": "#/backend/entities/LevelProgress",
      "description": "Fortschritt des Nutzers."
    },
    "/articles/{articleId}": {
      "schema": "#/backend/entities/Article",
      "description": "Wissensartikel."
    }
  }
}
