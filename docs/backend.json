
{
  "entities": {
    "Studio": {
      "title": "Studio",
      "type": "object",
      "description": "Ein Musik-Studio, das mehrere Spiele enthält.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "coverColor": { "type": "string" },
        "imageUrl": { "type": "string", "description": "Pfad zum Studio-Bild." },
        "district": { "type": "string" },
        "tags": { 
          "type": "array", 
          "items": { "type": "string" }
        },
        "linkUrl": { "type": "string", "format": "uri" },
        "linkLabel": { "type": "string" },
        "minRole": { "type": "string", "enum": ["admin", "producer", "pro", "free"], "default": "free" }
      },
      "required": ["id", "name"]
    },
    "Track": {
      "title": "Track",
      "type": "object",
      "description": "Ein Audio-Track.",
      "properties": {
        "id": { "type": "string" },
        "studioId": { "type": "string" },
        "name": { "type": "string" },
        "author": { "type": "string" },
        "duration": { "type": "number" },
        "url": { "type": "string", "format": "uri" }
      },
      "required": ["id", "name", "url"]
    },
    "Game": {
      "title": "Game",
      "type": "object",
      "description": "Ein Minigame innerhalb eines Studios.",
      "properties": {
        "id": { "type": "string" },
        "studioId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["rhythm-producer", "sample-hunter", "sample-catcher"] },
        "bpm": { "type": "number" },
        "difficulty": { "type": "number" },
        "trackId": { "type": "string" },
        "backingTrackUrl": { "type": "string", "format": "uri" },
        "backgroundImageUrl": { "type": "string", "format": "uri" },
        "minRole": { "type": "string", "enum": ["admin", "producer", "pro", "free"], "default": "free" }
      },
      "required": ["id", "studioId", "name", "type"]
    },
    "LearnApp": {
      "title": "LearnApp",
      "type": "object",
      "description": "Ein pädagogisches Modul.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["ear-training", "rhythm-trainer"] },
        "minRole": { "type": "string", "enum": ["admin", "producer", "pro", "free"], "default": "free" }
      },
      "required": ["id", "name", "type"]
    },
    "Level": {
      "title": "Level",
      "type": "object",
      "description": "Ein Schwierigkeitsgrad innerhalb eines Spiels.",
      "properties": {
        "id": { "type": "string" },
        "gameId": { "type": "string" },
        "difficulty": { "type": "number" },
        "name": { "type": "string" }
      },
      "required": ["id", "gameId", "difficulty"]
    },
    "TriggerPattern": {
      "title": "TriggerPattern",
      "type": "object",
      "description": "Ein rhythmisches Muster.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sampleUrl": { "type": "string", "format": "uri" },
        "steps": { 
          "type": "array", 
          "items": { "type": "number" }
        }
      },
      "required": ["id", "name", "steps"]
    },
    "Sound": {
      "title": "Sound",
      "type": "object",
      "description": "Ein Instrument-Trigger.",
      "properties": {
        "id": { "type": "string" },
        "levelId": { "type": "string" },
        "type": { "type": "string", "enum": ["kick", "clap", "percs", "misc"] },
        "sampleUrl": { "type": "string", "format": "uri" },
        "patternIds": { 
          "type": "array", 
          "items": { "type": "string" }
        }
      },
      "required": ["id", "levelId", "type", "sampleUrl", "patternIds"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Nutzer-Statistiken und Einstellungen.",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "producer", "pro", "free"], "default": "free" },
        "streetCred": { "type": "number", "default": 0 },
        "displayName": { "type": "string", "description": "Öffentlich angezeigter Name." },
        "isPublic": { "type": "boolean", "default": false, "description": "Ob der Nutzer im Highscore erscheint." }
      },
      "required": ["uid"]
    },
    "LevelProgress": {
      "title": "LevelProgress",
      "type": "object",
      "description": "Fortschritt in einem Level.",
      "properties": {
        "levelId": { "type": "string" },
        "accuracy": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["levelId", "accuracy"]
    },
    "PatternProgress": {
      "title": "PatternProgress",
      "type": "object",
      "description": "Fortschritt in einem Rhythmus-Pattern.",
      "properties": {
        "patternId": { "type": "string" },
        "accuracy": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patternId", "accuracy"]
    },
    "LearnCategory": {
      "title": "LearnCategory",
      "type": "object",
      "description": "Eine Hauptkategorie für die Knowledge Base.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "iconName": { "type": "string", "description": "Name des Lucide-Icons." },
        "colorClass": { "type": "string", "description": "CSS-Klasse für die Farbe." },
        "order": { "type": "number" },
        "minRole": { "type": "string", "enum": ["admin", "producer", "pro", "free"], "default": "free" }
      },
      "required": ["id", "title", "order"]
    },
    "LearnSubCat": {
      "title": "LearnSubCat",
      "type": "object",
      "description": "Eine Unterkategorie für die Knowledge Base.",
      "properties": {
        "id": { "type": "string" },
        "categoryId": { "type": "string" },
        "title": { "type": "string" },
        "iconUrl": { "type": "string" },
        "order": { "type": "number" },
        "minRole": { "type": "string", "enum": ["admin", "producer", "pro", "free"], "default": "free" }
      },
      "required": ["id", "categoryId", "title", "order"]
    },
    "Article": {
      "title": "Article",
      "type": "object",
      "description": "Ein KnowHow-Artikel.",
      "properties": {
        "id": { "type": "string" },
        "categoryId": { "type": "string" },
        "subCategoryId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "videoUrl": { "type": "string", "format": "uri" },
        "order": { "type": "number" },
        "imageUrls": { 
          "type": "array", 
          "items": { "type": "string" }
        },
        "youtubeUrls": { 
          "type": "array", 
          "items": { "type": "string" }
        },
        "minRole": { "type": "string", "enum": ["admin", "producer", "pro", "free"], "default": "free" }
      },
      "required": ["id", "title", "order"]
    },
    "LearnQuiz": {
      "title": "LearnQuiz",
      "type": "object",
      "description": "Ein Quiz zu einem Artikel.",
      "properties": {
        "id": { "type": "string", "description": "Gleich der Article-ID." },
        "articleId": { "type": "string" },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } },
              "correctOption": { "type": "number" }
            }
          }
        }
      },
      "required": ["id", "articleId", "questions"]
    },
    "ArticleProgress": {
      "title": "ArticleProgress",
      "type": "object",
      "description": "Artikel-Fortschritt.",
      "properties": {
        "articleId": { "type": "string" },
        "completed": { "type": "boolean" },
        "quizScore": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["articleId", "completed"]
    }
  },
  "auth": {
    "providers": ["anonymous", "google.com"]
  },
  "firestore": {
    "/studios/{studioId}": {
      "schema": "#/backend/entities/Studio",
      "description": "Studios."
    },
    "/tracks/{trackId}": {
      "schema": "#/backend/entities/Track",
      "description": "Tracks."
    },
    "/games/{gameId}": {
      "schema": "#/backend/entities/Game",
      "description": "Minigames."
    },
    "/learnApps/{appId}": {
      "schema": "#/backend/entities/LearnApp",
      "description": "Lern-Apps."
    },
    "/levels/{levelId}": {
      "schema": "#/backend/entities/Level",
      "description": "Levels."
    },
    "/levels/{levelId}/sounds/{soundId}": {
      "schema": "#/backend/entities/Sound",
      "description": "Sounds."
    },
    "/patterns/{patternId}": {
      "schema": "#/backend/entities/TriggerPattern",
      "description": "Patterns."
    },
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "Profile."
    },
    "/users/{userId}/progress/{levelId}": {
      "schema": "#/backend/entities/LevelProgress",
      "description": "Level-Fortschritt."
    },
    "/users/{userId}/patternProgress/{patternId}": {
      "schema": "#/backend/entities/PatternProgress",
      "description": "Pattern-Fortschritt."
    },
    "/users/{userId}/articleProgress/{articleId}": {
      "schema": "#/backend/entities/ArticleProgress",
      "description": "Artikel-Fortschritt."
    },
    "/learnCategories/{categoryId}": {
      "schema": "#/backend/entities/LearnCategory",
      "description": "Hauptkategorien."
    },
    "/learnSubCats/{subCategoryId}": {
      "schema": "#/backend/entities/LearnSubCat",
      "description": "Unterkategorien."
    },
    "/articles/{articleId}": {
      "schema": "#/backend/entities/Article",
      "description": "Artikel."
    },
    "/learnQuizzes/{quizId}": {
      "schema": "#/backend/entities/LearnQuiz",
      "description": "Quizzes."
    }
  }
}
