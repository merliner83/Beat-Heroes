
{
  "entities": {
    "Studio": {
      "title": "Studio",
      "type": "object",
      "description": "Ein Musik-Studio, das mehrere Spiele enthält.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "coverColor": { "type": "string" },
        "imageUrl": { "type": "string", "description": "Pfad zum Studio-Bild (z.B. /studios/house1.png)" },
        "district": { "type": "string", "description": "Der Stadtteil/Distrikt, in dem das Studio liegt." },
        "tags": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "Stile oder Kategorien (z.B. Hip-Hop, Techno)." 
        },
        "linkUrl": { "type": "string", "format": "uri", "description": "Eine externe Webseite oder Social Media Link." },
        "linkLabel": { "type": "string", "description": "Der Text, der für den Link angezeigt werden soll." },
        "minRole": { "type": "string", "enum": ["admin", "producer", "pro", "free"], "default": "free", "description": "Mindestens erforderliche Rolle für dieses Studio." }
      },
      "required": ["id", "name"]
    },
    "Track": {
      "title": "Track",
      "type": "object",
      "description": "Ein Audio-Track, der als Backing-Track für Spiele oder Vorschau dient.",
      "properties": {
        "id": { "type": "string" },
        "studioId": { "type": "string", "description": "Zugehörigkeit zu einem Studio." },
        "name": { "type": "string" },
        "author": { "type": "string", "description": "Der Produzent des Tracks." },
        "duration": { "type": "number", "description": "Länge in Sekunden." },
        "url": { "type": "string", "format": "uri" }
      },
      "required": ["id", "name", "url"]
    },
    "Game": {
      "title": "Game",
      "type": "object",
      "description": "Ein Minigame innerhalb eines Studios.",
      "properties": {
        "id": { "type": "string" },
        "studioId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["rhythm-producer", "sample-hunter", "sample-catcher"], "description": "Der technische Typ des Spiels." },
        "bpm": { "type": "number", "description": "Geschwindigkeit." },
        "difficulty": { "type": "number", "description": "Schwierigkeitsgrad (1-4)" },
        "trackId": { "type": "string", "description": "ID des zugehörigen Tracks." },
        "backingTrackUrl": { "type": "string", "format": "uri", "description": "Backing Track URL." },
        "backgroundImageUrl": { "type": "string", "format": "uri", "description": "Hintergrundbild." },
        "minRole": { "type": "string", "enum": ["admin", "producer", "pro", "free"], "default": "free", "description": "Rollen-Hürde." }
      },
      "required": ["id", "studioId", "name", "type"]
    },
    "LearnApp": {
      "title": "LearnApp",
      "type": "object",
      "description": "Ein pädagogisches Modul im Learn Center.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["ear-training", "rhythm-trainer"] },
        "minRole": { "type": "string", "enum": ["admin", "producer", "pro", "free"], "default": "free" }
      },
      "required": ["id", "name", "type"]
    },
    "Level": {
      "title": "Level",
      "type": "object",
      "description": "Ein Schwierigkeitsgrad innerhalb eines Spiels.",
      "properties": {
        "id": { "type": "string" },
        "gameId": { "type": "string" },
        "difficulty": { "type": "number", "description": "1 bis 4" },
        "name": { "type": "string" }
      },
      "required": ["id", "gameId", "difficulty"]
    },
    "TriggerPattern": {
      "title": "TriggerPattern",
      "type": "object",
      "description": "Ein rhythmisches Muster.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sampleUrl": { "type": "string", "format": "uri", "description": "Der Sound, der für dieses Pattern abgespielt wird." },
        "steps": { 
          "type": "array", 
          "items": { "type": "number" },
          "description": "Schritte (0-127)."
        }
      },
      "required": ["id", "name", "steps"]
    },
    "Sound": {
      "title": "Sound",
      "type": "object",
      "description": "Ein Instrument-Trigger innerhalb eines Levels.",
      "properties": {
        "id": { "type": "string" },
        "levelId": { "type": "string" },
        "type": { "type": "string", "enum": ["kick", "clap", "percs", "misc"] },
        "sampleUrl": { "type": "string", "format": "uri" },
        "patternIds": { 
          "type": "array", 
          "items": { "type": "string" }
        }
      },
      "required": ["id", "levelId", "type", "sampleUrl", "patternIds"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Nutzer-Statistiken und Rollen.",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "producer", "pro", "free"], "default": "free" },
        "streetCred": { "type": "number", "default": 0 }
      },
      "required": ["uid"]
    },
    "LevelProgress": {
      "title": "LevelProgress",
      "type": "object",
      "description": "Fortschritt in einem Level.",
      "properties": {
        "levelId": { "type": "string" },
        "accuracy": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["levelId", "accuracy"]
    },
    "PatternProgress": {
      "title": "PatternProgress",
      "type": "object",
      "description": "Fortschritt in einem Rhythmus-Pattern.",
      "properties": {
        "patternId": { "type": "string" },
        "accuracy": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patternId", "accuracy"]
    },
    "Article": {
      "title": "Article",
      "type": "object",
      "description": "Ein KnowHow-Artikel.",
      "properties": {
        "id": { "type": "string" },
        "categoryId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "videoUrl": { "type": "string", "format": "uri" },
        "imageUrls": { 
          "type": "array", 
          "items": { "type": "string" }
        },
        "minRole": { "type": "string", "enum": ["admin", "producer", "pro", "free"], "default": "free" }
      },
      "required": ["id", "title"]
    }
  },
  "auth": {
    "providers": ["anonymous", "google.com"]
  },
  "firestore": {
    "/studios/{studioId}": {
      "schema": "#/backend/entities/Studio",
      "description": "Studios."
    },
    "/tracks/{trackId}": {
      "schema": "#/backend/entities/Track",
      "description": "Tracks."
    },
    "/games/{gameId}": {
      "schema": "#/backend/entities/Game",
      "description": "Minigames."
    },
    "/learnApps/{appId}": {
      "schema": "#/backend/entities/LearnApp",
      "description": "Lern-Apps."
    },
    "/levels/{levelId}": {
      "schema": "#/backend/entities/Level",
      "description": "Levels."
    },
    "/levels/{levelId}/sounds/{soundId}": {
      "schema": "#/backend/entities/Sound",
      "description": "Sounds."
    },
    "/patterns/{patternId}": {
      "schema": "#/backend/entities/TriggerPattern",
      "description": "Patterns."
    },
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "Profile."
    },
    "/users/{userId}/progress/{levelId}": {
      "schema": "#/backend/entities/LevelProgress",
      "description": "Level-Fortschritt."
    },
    "/users/{userId}/patternProgress/{patternId}": {
      "schema": "#/backend/entities/PatternProgress",
      "description": "Pattern-Fortschritt."
    },
    "/articles/{articleId}": {
      "schema": "#/backend/entities/Article",
      "description": "Artikel."
    }
  }
}
