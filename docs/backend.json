
{
  "entities": {
    "Studio": {
      "title": "Studio",
      "type": "object",
      "description": "Ein Musik-Studio, das mehrere Projekte enthält.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "coverColor": { "type": "string" },
        "district": { "type": "string", "description": "Der Stadtteil/Distrikt, in dem das Studio liegt." },
        "linkUrl": { "type": "string", "format": "uri", "description": "Eine externe Webseite oder Social Media Link." },
        "linkLabel": { "type": "string", "description": "Der Text, der für den Link angezeigt werden soll." }
      },
      "required": ["id", "name"]
    },
    "Project": {
      "title": "Project",
      "type": "object",
      "description": "Ein Musikprojekt (Song) innerhalb eines Studios.",
      "properties": {
        "id": { "type": "string" },
        "studioId": { "type": "string" },
        "name": { "type": "string" },
        "bpm": { "type": "number" },
        "backingTrackUrl": { "type": "string", "format": "uri" }
      },
      "required": ["id", "studioId", "name", "bpm", "backingTrackUrl"]
    },
    "Level": {
      "title": "Level",
      "type": "object",
      "description": "Ein Schwierigkeitsgrad innerhalb eines Projekts.",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "difficulty": { "type": "number", "description": "1 bis 4" },
        "name": { "type": "string" }
      },
      "required": ["id", "projectId", "difficulty"]
    },
    "TriggerPattern": {
      "title": "TriggerPattern",
      "type": "object",
      "description": "Ein wiederverwendbares rhythmisches Muster über 1 Takt (16 Steps).",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "steps": { 
          "type": "array", 
          "items": { "type": "number" },
          "description": "Schritte (0-15) für einen einzelnen Takt."
        }
      },
      "required": ["id", "name", "steps"]
    },
    "Sound": {
      "title": "Sound",
      "type": "object",
      "description": "Ein Instrument-Trigger innerhalb eines Levels mit einer Abfolge von Patterns.",
      "properties": {
        "id": { "type": "string" },
        "levelId": { "type": "string" },
        "type": { "type": "string", "enum": ["kick", "clap", "percs", "misc"] },
        "sampleUrl": { "type": "string", "format": "uri" },
        "patternSequence": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "Eine Liste von 8 Pattern-IDs für einen 8-Takt-Loop."
        }
      },
      "required": ["id", "levelId", "type", "sampleUrl"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Nutzer-Statistiken und Street Credibilities.",
      "properties": {
        "uid": { "type": "string" },
        "streetCred": { "type": "number", "default": 0 }
      },
      "required": ["uid"]
    },
    "LevelProgress": {
      "title": "LevelProgress",
      "type": "object",
      "description": "Trackt den Fortschritt eines Nutzers in einem Level.",
      "properties": {
        "levelId": { "type": "string" },
        "accuracy": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["levelId", "accuracy"]
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "/studios/{studioId}": {
      "schema": "#/backend/entities/Studio",
      "description": "Öffentliche Studios."
    },
    "/projects/{projectId}": {
      "schema": "#/backend/entities/Project",
      "description": "Unabhängige Projekte."
    },
    "/levels/{levelId}": {
      "schema": "#/backend/entities/Level",
      "description": "Unabhängige Levels."
    },
    "/levels/{levelId}/sounds/{soundId}": {
      "schema": "#/backend/entities/Sound",
      "description": "Sounds eines Levels."
    },
    "/patterns/{patternId}": {
      "schema": "#/backend/entities/TriggerPattern",
      "description": "Globale Rhythmus-Vorlagen (1 Takt)."
    },
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "Nutzer-Profile mit Street Cred."
    },
    "/users/{userId}/progress/{levelId}": {
      "schema": "#/backend/entities/LevelProgress",
      "description": "Fortschritt des Nutzers pro Level."
    }
  }
}
